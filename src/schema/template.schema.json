{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undangankuuu.local/schema/template.schema.json",
  "title": "Wedding Template Scene Schema V1",
  "type": "object",
  "required": ["project", "theme", "scenes"],
  "properties": {
    "project": { "$ref": "#/$defs/project" },
    "theme": { "$ref": "#/$defs/theme" },
    "audio": { "$ref": "#/$defs/audio" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": ["id", "name", "version", "seed"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "preset": { "type": "string" },
        "seed": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "palette": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "src": { "type": "string" },
        "autoplayAfterOpen": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "fadeInMs": { "type": "integer", "minimum": 0 }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "type", "layers"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["cover", "intro", "couple", "event", "story", "gallery", "rsvp", "gift", "closing", "custom"]
        },
        "preset": { "type": "string" },
        "background": { "$ref": "#/$defs/background" },
        "atmosphere": { "$ref": "#/$defs/atmosphere" },
        "timeline": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineStep" }
        },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layer" }
        },
        "responsive": { "$ref": "#/$defs/responsive" }
      }
    },
    "background": {
      "type": "object",
      "properties": {
        "type": { "enum": ["color", "gradient", "image", "video", "slideshow", "procedural"] },
        "src": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "transition": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "transitionMs": { "type": "integer", "minimum": 0 },
        "kenBurns": { "type": "string" }
      }
    },
    "atmosphere": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": { "enum": ["overlay", "glass", "frost", "glow", "bloom", "vignette", "grain", "noise", "light-leak", "mist"] }
        },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "timelineStep": {
      "type": "object",
      "required": ["at", "target", "action"],
      "properties": {
        "at": { "type": "integer", "minimum": 0 },
        "target": { "type": "string" },
        "action": { "type": "string" },
        "value": {}
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["text", "image", "svg", "video", "decor", "particle", "shape", "button", "countdown", "gallery", "slider", "form", "custom"] },
        "role": { "enum": ["background", "decor-back", "ambient", "atmosphere", "decor-main", "media", "content", "decor-front", "interaction", "floating"] },
        "content": {},
        "asset": { "$ref": "#/$defs/asset" },
        "transform": { "$ref": "#/$defs/transform" },
        "style": { "type": "object", "additionalProperties": true },
        "motion": { "$ref": "#/$defs/motion" },
        "particle": { "$ref": "#/$defs/particle" },
        "responsive": { "$ref": "#/$defs/responsive" }
      }
    },
    "asset": {
      "type": "object",
      "properties": {
        "type": { "enum": ["local", "generated", "procedural", "remote"] },
        "src": { "type": "string" },
        "generator": { "type": "string" },
        "variant": { "type": "string" }
      }
    },
    "transform": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": ["number", "string"] },
        "height": { "type": ["number", "string"] },
        "scale": { "type": "number" },
        "rotate": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "depth": { "type": "number" },
        "z": { "type": "integer" },
        "anchor": { "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"] }
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "preset": { "type": "string" },
        "delayMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "easing": { "type": "string" },
        "distance": { "type": "number" },
        "once": { "type": "boolean" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" },
        "parallax": { "type": "number" }
      }
    },
    "particle": {
      "type": "object",
      "properties": {
        "type": { "enum": ["snow", "gold-dust", "sparkle", "stars", "petals", "leaves", "bokeh", "embers", "mist", "floating-dots"] },
        "density": { "type": "integer", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "size": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "direction": { "type": "string" },
        "wind": { "type": "number" },
        "color": { "type": "string" },
        "randomness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "responsive": {
      "type": "object",
      "properties": {
        "desktop": { "type": "object", "additionalProperties": true },
        "tablet": { "type": "object", "additionalProperties": true },
        "mobile": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
